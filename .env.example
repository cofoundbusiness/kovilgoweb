# ==============================================================================
# KOVILGO PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT store real production secrets in this file.
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Base
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth
# ------------------------------------------------------------------------------
# Public client credentials (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged service role (SERVER-ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Pooled connection string (Port 6543 / PgBouncer mode for serverless Next.js)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x

# Direct connection string (Port 5432 - used for running Drizzle migrations)
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Payments — Cashfree Payment Gateway
# ------------------------------------------------------------------------------
CASHFREE_APP_ID=TEST_APP_ID
CASHFREE_SECRET_KEY=TEST_SECRET_KEY
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENVIRONMENT=SANDBOX

# ------------------------------------------------------------------------------
# SMS OTP — MSG91 Integration
# ------------------------------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_otp_template_id
MSG91_SENDER_ID=KOVILG

# ------------------------------------------------------------------------------
# Transactional Email — Resend
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="KovilGo <concierge@kovilgo.com>"

# ------------------------------------------------------------------------------
# Rate Limiting & Distributed Cache — Upstash Redis
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ------------------------------------------------------------------------------
# Bot Protection — Cloudflare Turnstile
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# Media Storage & CDN — Cloudinary
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=kovilgo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Error Tracking & Telemetry — Sentry
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your_sentry_release_auth_token
